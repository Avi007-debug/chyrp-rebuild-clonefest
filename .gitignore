# Root .gitignore for chyrp-rebuild

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Virtual environments
.venv/
venv/
env/

# Environment files (secrets)
.env
.env.*

# Logs
logs/
*.log

# Coverage / testing
.pytest_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
build/

# Uploads / user generated content
backend/uploads/
chyrp/uploads/

# Editor / OS files
.vscode/
.DS_Store
Thumbs.db

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
